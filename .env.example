# Local development; never add real secrets to this example.
# INFERENCE_BACKEND=ollama (default) or gateway (shared LiteLLM gateway, hosted mode)
INFERENCE_BACKEND=ollama
# GATEWAY_BASE_URL=http://litellm:4000
# GATEWAY_API_KEY=   # virtual key from ai-gateway scripts/new_app_key.sh; never commit
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GLM_MODEL=glm4:9b
DEEPSEEK_MODEL=deepseek-r1:7b
LLM_TIMEOUT=180
LLM_CONTEXT_TOKENS=8192
LLM_OUTPUT_TOKENS=2048
REQUESTS_PER_MINUTE=30
REQUESTS_PER_DAY=1000
UPLOAD_MAX_BYTES=20971520
EXTRACT_TIMEOUT=120
EMBEDDED_WORKER=true
PRODUCTION=false
AUTH_ENABLED=false
# Before production startup, set AUTH_ENABLED=true and PRODUCTION=true.
# AUTH_TOKENS={"<sha256-digest>":{"workspace":"class-a","role":"admin"}}
# CORS_ORIGINS=[]
# PUBLIC_BASE_URL=https://your-domain.example
# PUBLIC_HOST=your-domain.example

# Hosted billing (see engineering/runbooks/billing.md). Never commit real values.
# BILLING_ENABLED=true
# BILLING_BASE_URL=http://billing:8100
# BILLING_SERVICE_TOKEN=      # long random string shared by the app and the billing service
# BILLING_DB_PASSWORD=
# TOP_UP_URL=https://your-domain.example/top-up
# GATEWAY_ADMIN_KEY=          # read-only use: billing-jobs reads spend logs to reconcile

# Hosted accounts and storage (docker-compose.hosted.yml; see engineering/runbooks/accounts.md).
# PUBLIC_HOST=app.example.com
# AUTH_HOST=auth.example.com            # where learners sign in (Logto), a second hostname
# OIDC_AUDIENCE=https://api.example.com # the API identifier you create in the Logto console
# APP_DB_PASSWORD=
# LOGTO_DB_PASSWORD=
# LOGTO_MANAGEMENT_APP_ID=              # optional: lets account deletion also remove the sign-in
# LOGTO_MANAGEMENT_APP_SECRET=
