# Local development; never add real secrets to this example.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GLM_MODEL=glm4:9b
DEEPSEEK_MODEL=deepseek-r1:7b
LLM_TIMEOUT=180
LLM_CONTEXT_TOKENS=8192
LLM_OUTPUT_TOKENS=2048
REQUESTS_PER_MINUTE=30
REQUESTS_PER_DAY=1000
UPLOAD_MAX_BYTES=20971520
EXTRACT_TIMEOUT=120
EMBEDDED_WORKER=true
PRODUCTION=false
AUTH_ENABLED=false
# Before production startup, set AUTH_ENABLED=true and PRODUCTION=true.
# AUTH_TOKENS={"<sha256-digest>":{"workspace":"class-a","role":"admin"}}
# CORS_ORIGINS=[]
# PUBLIC_BASE_URL=https://your-domain.example
# PUBLIC_HOST=your-domain.example
