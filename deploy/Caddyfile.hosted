# Hosted deployment: the app and the sign-in service on two hostnames, TLS from Let's Encrypt.
{$PUBLIC_HOST} {
    encode zstd gzip
    # Signed payment notifications (Paddle, RevenueCat) go straight to billing; no other billing route is public.
    @payments path /webhooks/paddle /webhooks/revenuecat
    handle @payments {
        reverse_proxy billing:8100
    }
    handle {
        reverse_proxy web:8000 {
            flush_interval -1
            transport http {
                read_timeout 900s
            }
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

{$AUTH_HOST} {
    encode zstd gzip
    reverse_proxy logto:3001
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
